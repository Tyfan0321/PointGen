{
    "seed": 1,
    "runname": "3dmatch",
    "output_dir": "./result/1.14_3dmatch_without_decay_orign_x_pred_v_loss_aug_10epoch_wo_noised_pe_cat_silu/",
    "logging_dir": "logs",
    "log_with": "tensorboard",
    "mixed_precision": "no",
    "gradient_accumulation_steps": 4,
    "clip_grad_norm": 1.0,
    "num_workers": 8,
    "train_batch_size": 32,
    "num_train_epochs": 200,
    "num_train_steps": null,
    "log_steps": 1,
    "ckpt_epochs": 5,
    "val_epochs": 1,
    "feat_stop_epoch": 10,
    "do_gen": true,
    "num_gen_samples": 10,
    "num_inference_steps": 5,
    "inference_type": "fm-euler",

    "data": {
        "root": "/remote-home/share/datasets/3DMatch/raw_data",
        "data_list": "./data/3dmatch_list/",
        "npoints": 30000,
        "voxel_size": 0.025,
        "augment": 1.0
    },

    "scheduler": {
        "num_train_timesteps": 1000
    },

    "processor": {
        "kpconv_layers": 4,
        "voxel_size": 0.025,
        "init_radius": 0.0625,
        "neighbor_limits": [26, 21, 22, 25]
    },

    "model": {
        "kpconv_layers": 4,
        "input_dim": 1,
        "init_dim": 64,
        "kernel_size": 15,
        "init_radius": 0.0625,
        "init_sigma": 0.05,
        "in_dim": 3,
        "in_dim_context": 1024,
        "hidden_dim": 256,
        "num_attention_heads": 8,
        "activation_fn": "geglu",
        "num_layers": 6,
        "norm_type": "ada_norm_zero",
        "scale": null
    },

    "optim": {
        "lr": 1e-4,
        "adam_beta1": 0.9,
        "adam_beta2": 0.999,
        "adam_eps": 1e-8,
        "adam_weight_decay": 1e-4
    },

    "lr_scheduler": {
        "name": "cosine",
        "lr_warmup_steps": 1000,
        "lr_num_cycles": 0.5
    },
    
    "loss": {
        "learn_w": true,
        "r_p": 0.05,
        "r_n": 0.06
    },

    "eval": {
        "rte_threshold": 0.3,
        "rre_threshold": 15.0
    }
}
