{
    "seed": 1,
    "log_steps": 200,
    "save_steps": 7000,
    "step_steps": 5000,
    "dataset": "3dmatch",
    "runname": "castdm",
    "log_dir": "./logs/3dmatch/",
    "snapshot_dir": "./ckpt/3dmatch_ptt/",
    "data_list": "./data/3dmatch_list/",

    "data": {
        "root": "/home/jacko/Downloads/3dmatch/",
        "num_workers": 4,
        "npoints": 30000,
        "voxel_size": 0.025,
        "augment": 0.5
    },

    "model": {
        "kpconv_layers": 4,
        "voxel_size": 0.025,
        "input_dim": 1,
        "init_dim": 64,
        "kernel_size": 15,
        "init_radius": 0.0625,
        "init_sigma": 0.05,
        "neighbor_limits": [26, 21, 22, 25],

        "pyramid_levels": 3,
        "growing_factor": 2,
        "input_dim_f": 512,
        "input_dim_c": 1024,
        "output_dim": 256,
        "hidden_dim": 256,
        "ffn_dim": 1024,
        "num_heads": 8,
        "dropout": null,
        "activation_fn": "relu",
        "sigma_d": 0.2,
        "sigma_a": 15,
        "angle_k": 3,
        "reduction_a": "max",
        "blocks": 6,
        "dual_normalization": true
    },

    "optim": {
        "lr": 1e-4,
        "step_size": 206420,
        "weight_decay": 0.0001,
        "gamma": 0.5,
        "max_epoch": 30,
        "clip_grad_norm": 0.1
    },
    
    "loss": {
        "weight_feat_loss": 0.1,
        "weight_conf_loss": 1.0,
        "weight_corr_loss": 1.0
    },

    "eval": {
        "rte_threshold": 0.3,
        "rre_threshold": 15.0,
        "rmse_threshold": 0.2,
        "inlier_distance_threshold": 0.1,
        "inlier_ratio_threshold": 0.05
    }
}
